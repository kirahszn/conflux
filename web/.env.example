# Copy to web/.env.local (gitignored). Public values only: everything here is sent to the browser.
# All network values live in src/config/network.ts. These variables only select or override them.

# testnet (default) or mainnet
# NEXT_PUBLIC_NETWORK=testnet

# Optional overrides for the selected network
# NEXT_PUBLIC_CONTRACT_ID=
# NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8787
# NEXT_PUBLIC_NEAR_RPC_URL=
