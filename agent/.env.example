# Copy to agent/.env.<name> (e.g. .env.research) — gitignored — and run: npm start -- <name>
# No secrets here. The NEAR AI key is read from the repo-root .env (NEARAI_API_KEY);
# Network: set NEAR_NETWORK in the real environment (not in this file), default testnet.
#   NEAR_NETWORK=mainnet npm run agents:all -> reads agent/.env.mainnet.<name> (never .env.<name>),
#   keys from ~/.near-credentials/mainnet/, state in agent/state-mainnet, default mainnet RPC.
# Startup refuses if the RPC chain_id differs or an account id has the wrong suffix.
# the agent's NEAR key from ~/.near-credentials/testnet/<AGENT_ID>.json.
AGENT_ID=agent.research-blessing.testnet
ROLE=research
CONTRACT_ID=v2.conflux-blessing.testnet
COORDINATOR_URL=http://localhost:8787
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Primary: deepseek-ai/DeepSeek-V4.1-Flash-1017   Backup: Qwen/Qwen3.8-27B
MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Two phases per slot: GATHER (streamed, web search, gateway signature) then
# WRITE (non-streamed, no tools, provider_tee signature; proof_ref points to WRITE).
GATHER_MAX_TOKENS=1500
WRITE_MAX_TOKENS=3000
# false = skip GATHER; WRITE works without gathered facts
WEB_SEARCH=true
# Estimated AI spend cap for this agent in USD (tracked in agent/state/<AGENT_ID>.json)
SPEND_LIMIT_USD=0.05
# List prices used for the estimate (DeepSeek V4.1 Flash defaults; change with MODEL)
# PRICE_IN_PER_M=0.3
# PRICE_OUT_PER_M=1.2
# SEARCH_PRICE=0.005
# Comma-separated task ids this agent must ignore
SKIP_TASK_IDS=
# true = no AI call; submits a clearly labelled placeholder. Dev only.
DRY_RUN=false
# Optional: POLL_INTERVAL_MS=10000
