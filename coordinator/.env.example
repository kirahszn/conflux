# Copy to .env (gitignored). No secrets here: the coordinator's private key is
# read from ~/.near-credentials/testnet/<COORDINATOR_ID>.json, never from .env.
# Network: set NEAR_NETWORK in the real environment (not in this file), default testnet.
#   NEAR_NETWORK=mainnet npm start  -> reads .env.mainnet (never .env), keys from
#   ~/.near-credentials/mainnet/, data in ./data-mainnet, port 8788, default mainnet RPC.
# Startup refuses if the RPC chain_id differs or an account id has the wrong suffix.
CONTRACT_ID=v2.conflux-blessing.testnet
COORDINATOR_ID=coordinator.conflux-blessing.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
PORT=8787
# Optional: where the SQLite file lives (default ./data/coordinator.db)
# DB_PATH=./data/coordinator.db
# Optional: watcher interval in ms (default 10000)
# WATCH_INTERVAL_MS=10000
# Stage 3.4 synthesis (NEAR AI key comes from the repo-root .env: NEARAI_API_KEY)
# MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# SYNTH_MAX_TOKENS=3000
# SYNTH_SPEND_LIMIT_USD=0.03     # estimated, across all synthesis calls (tracked in the DB)
# PRICE_IN_PER_M=0.3
# PRICE_OUT_PER_M=1.2
# Stage 3.5 planning (POST /plan): estimated spend cap across all planning calls
# PLAN_SPEND_LIMIT_USD=0.02
